{
  "rewrites": [
    {
      "source": "/paket",
      "destination": "/paket.html"
    },
    {
      "source": "/paket/",
      "destination": "/paket.html"
    },
    {
      "source": "/panel",
      "destination": "/panel.html"
    },
    {
      "source": "/panel/",
      "destination": "/panel.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}